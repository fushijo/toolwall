+/*
+ * Is this Ninjabrain Bot?
+ *
+ * The anchor is not an answer to that question. It belongs to whichever
+ * floating window opened first, which is Ninjabrain Bot only by habit: close it
+ * and the next window to open inherits the slot, so anything keyed off the
+ * anchor ends up applying to the wrong window.
+ */
+static bool
+view_is_ninb(struct server_view *view) {
+    char *title = server_view_get_title(view);
+    if (!title) {
+        return false;
+    }
+
+    bool match = strstr(title, "Ninjabrain") != nullptr;
+    free(title);
+
+    return match;
+}
+
+static bool
+should_hide(struct wrap *wrap, struct server_view *view) {
+    return wrap->cfg->theme.ninb.hidden && view_is_ninb(view);
+}
