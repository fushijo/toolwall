+    }
+
+    server_gl_shader_use(scene->shaders.data[rect->shader_index].shader);
+    glUniform2f(scene->shaders.data[rect->shader_index].shader_u_dst_size, scene->ui->render_width,
+                scene->ui->render_height);
+    glUniform2f(scene->shaders.data[rect->shader_index].shader_u_src_size, 1, 1);
+
+    gl_using_buffer(GL_ARRAY_BUFFER, rect->vbo) {
