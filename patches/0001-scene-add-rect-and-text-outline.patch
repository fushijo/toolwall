+    struct vtx_shader vertices[6] = {};
+
+    // The rect is drawn as a 1x1 white texture with a color key that always matches, which is
+    // the cheapest way to get a solid fill out of the existing texcopy shader.
+    rect_build(vertices, &(struct box){0, 0, 1, 1}, &options->dst, (float[4]){1, 1, 1, 1},
