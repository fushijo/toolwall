+static int
+unmarshal_hex_key(lua_State *L, int table_index, const char *key, float rgba[static 4]) {
+    lua_pushstring(L, key);
+    lua_rawget(L, table_index);
+
+    if (lua_type(L, -1) == LUA_TSTRING) {
+        const char *raw_color = lua_tostring(L, -1);
+
+        uint8_t u8_rgba[4] = {};
+        if (config_parse_hex(u8_rgba, raw_color) != 0) {
+            return luaL_error(L, "expected a valid hex color, got '%s'", raw_color);
+        }
+
+        for (size_t i = 0; i < 4; i++) {
+            rgba[i] = (float)u8_rgba[i] / UINT8_MAX;
+        }
+    }
+    lua_pop(L, 1);
+
+    return 0;
+}
