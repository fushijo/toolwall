diff --git a/include/config/config.h b/include/config/config.h
index c7dde6a..946575b 100644
--- a/include/config/config.h
+++ b/include/config/config.h
@@ -61,6 +61,11 @@ struct config {
             int32_t offset_x, offset_y;
 
             double opacity;
+
+            // Keep the anchored window hidden even while floating windows are shown. For
+            // configs that read Ninjabrain Bot through its HTTP API and draw the readout
+            // themselves, where the window itself is only in the way.
+            bool hidden;
         } ninb;
     } theme;
 
diff --git a/waywall/config/config.c b/waywall/config/config.c
index b807274..4468cda 100644
--- a/waywall/config/config.c
+++ b/waywall/config/config.c
@@ -763,6 +763,10 @@ process_config_theme(struct config *cfg) {
         return 1;
     }
 
+    if (get_bool(cfg, "ninb_hidden", &cfg->theme.ninb.hidden, "theme.ninb_hidden", false) != 0) {
+        return 1;
+    }
+
     return 0;
 }
 
diff --git a/waywall/wrap.c b/waywall/wrap.c
index 32ea33f..c73361f 100644
--- a/waywall/wrap.c
+++ b/waywall/wrap.c
@@ -30,6 +30,7 @@
 #include <xkbcommon/xkbcommon.h>
 
 #define IS_ANCHORED(wrap, view) (wrap->floating.anchored == view)
+#define SHOULD_HIDE(wrap, view) (wrap->cfg->theme.ninb.hidden && IS_ANCHORED(wrap, view))
 #define SHOULD_ANCHOR(wrap) (wrap->cfg->theme.ninb.anchor != ANCHOR_NONE)
 
 static void on_anchored_resize(struct wl_listener *listener, void *data);
@@ -85,7 +86,7 @@ floating_set_visible(struct wrap *wrap, bool visible) {
 
     struct floating_view *fview;
     wl_list_for_each (fview, &wrap->floating.views, link) {
-        server_view_set_visible(fview->view, visible);
+        server_view_set_visible(fview->view, visible && !SHOULD_HIDE(wrap, fview));
         server_view_commit(fview->view);
     }
 
@@ -211,6 +212,12 @@ floating_view_create(struct wrap *wrap, struct server_view *view) {
         server_view_set_visible(view, true);
     }
 
+    // The anchor is claimed further down, so a window that is about to become the anchored one
+    // has to be checked for here rather than through SHOULD_HIDE.
+    if (wrap->cfg->theme.ninb.hidden && SHOULD_ANCHOR(wrap) && !wrap->floating.anchored) {
+        server_view_set_visible(view, false);
+    }
+
     if (!SHOULD_ANCHOR(wrap) || wl_list_length(&wrap->floating.views) > 1) {
         server_view_set_centered(view, false);
         server_view_set_pos(view, 0, 0);
@@ -676,6 +683,14 @@ wrap_set_config(struct wrap *wrap, struct config *cfg) {
         floating_update_anchored(wrap);
     }
 
+    // theme.ninb_hidden can be flipped by a reload, so re-apply visibility rather than waiting
+    // for the next show_floating call.
+    struct floating_view *fview;
+    wl_list_for_each (fview, &wrap->floating.views, link) {
+        server_view_set_visible(fview->view, wrap->floating.visible && !SHOULD_HIDE(wrap, fview));
+        server_view_commit(fview->view);
+    }
+
     return 0;
 }
 
